# ==============================================================================
# CARSHAREPRO / DRIVESHARE - MASTER ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env in your root directory or populate these variables
# in your cloud deployment platform (Render, Railway, AWS, Heroku, Docker, etc.)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
# PORT: The port on which the Spring Boot backend server runs (Default: 8081)
PORT=8081

# FRONTEND_URL: The public URL of the React/Vite frontend (e.g. http://localhost:5173 or https://your-app.com)
# REQUIRED: Used for CORS configuration and email verification redirects
FRONTEND_URL=http://localhost:5173

# APP_INIT_DEMO_USERS: Whether to seed initial demo accounts (admin, renter, owner) on startup
# Options: true (for quick testing/demo) | false (recommended for production)
APP_INIT_DEMO_USERS=false

# ------------------------------------------------------------------------------
# 2. DATABASE (MONGODB / MONGODB ATLAS)
# ------------------------------------------------------------------------------
# MONGODB_URI: Full connection string for MongoDB Atlas or local MongoDB
# Format: mongodb+srv://<username>:<password>@<cluster-address>/<database-name>?retryWrites=true&w=majority
# REQUIRED
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/car_rental?retryWrites=true&w=majority

# MONGODB_DATABASE: Name of the MongoDB database (Default: car_rental)
MONGODB_DATABASE=car_rental

# ------------------------------------------------------------------------------
# 3. SECURITY & JWT AUTHENTICATION
# ------------------------------------------------------------------------------
# JWT_SECRET: Strong secret key for signing JSON Web Tokens (Minimum 256-bit / 32+ characters)
# REQUIRED in production. Generate using: openssl rand -base64 32
JWT_SECRET=your_secure_256_bit_jwt_secret_key_here_min_32_characters_long

# ------------------------------------------------------------------------------
# 4. CLOUDINARY MEDIA STORAGE (KYC, Car Photos, Vehicle Docs)
# ------------------------------------------------------------------------------
# Get your credentials at https://cloudinary.com/console
# REQUIRED for car image uploads and document verification
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 5. EMAIL SERVICES (Choose SMTP, Brevo, or Resend)
# ------------------------------------------------------------------------------
# Option A: Standard SMTP (e.g. Gmail App Password, SendGrid, Amazon SES)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your_16_character_app_password
MAIL_FROM=no-reply@yourdomain.com

# Option B: Brevo (Sendinblue) HTTP API (Recommended for cloud deployments)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=no-reply@yourdomain.com
BREVO_SENDER_NAME=DriveShare Car Rental

# Option C: Resend HTTP API
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM=DriveShare <onboarding@resend.dev>

# ------------------------------------------------------------------------------
# 6. UPI PAYMENT WORKFLOW (Dynamic QR Code & UTR Verification)
# ------------------------------------------------------------------------------
# PAYMENT_UPI_ID: Virtual Payment Address (VPA) receiving booking payments
# Example: businessname@okhdfcbank or merchant@upi
# REQUIRED for UPI QR generation
PAYMENT_UPI_ID=yourbusiness@upi

# PAYMENT_UPI_NAME: Registered Payee name displayed in UPI apps
PAYMENT_UPI_NAME=DriveShare Car Rental

# ------------------------------------------------------------------------------
# 7. FRONTEND VITE CONFIGURATION (Passed to frontend/.env)
# ------------------------------------------------------------------------------
# VITE_API_BASE_URL: Backend API base URL accessible from buyer's browser
# Local Development: http://localhost:8081
# Production: https://api.yourdomain.com
VITE_API_BASE_URL=http://localhost:8081
