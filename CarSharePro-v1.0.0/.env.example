# ==============================================================================
# CARSHAREPRO - MASTER ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env in your backend directory or populate these variables
# in your cloud deployment platform (Render, Railway, AWS, Heroku, Docker, etc.)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
PORT=8081
FRONTEND_URL=http://localhost:5173
APP_INIT_DEMO_USERS=false

# ------------------------------------------------------------------------------
# 2. DATABASE (MONGODB / MONGODB ATLAS)
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/car_rental?retryWrites=true&w=majority
MONGODB_DATABASE=car_rental

# ------------------------------------------------------------------------------
# 3. SECURITY & JWT AUTHENTICATION
# ------------------------------------------------------------------------------
JWT_SECRET=your_secure_256_bit_jwt_secret_key_here_min_32_characters_long

# ------------------------------------------------------------------------------
# 4. CLOUDINARY MEDIA STORAGE (KYC, Car Photos, Vehicle Docs)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 5. EMAIL SERVICES (Choose SMTP, Brevo, or Resend)
# ------------------------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your_16_character_app_password
MAIL_FROM=no-reply@yourdomain.com

BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=no-reply@yourdomain.com
BREVO_SENDER_NAME=DriveShare Car Rental

RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM=DriveShare <onboarding@resend.dev>

# ------------------------------------------------------------------------------
# 6. UPI PAYMENT WORKFLOW (Dynamic QR Code & UTR Verification)
# ------------------------------------------------------------------------------
PAYMENT_UPI_ID=yourbusiness@upi
PAYMENT_UPI_NAME=DriveShare Car Rental

# ------------------------------------------------------------------------------
# 7. FRONTEND VITE CONFIGURATION (Passed to frontend/.env)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8081
