# ==========================================
# SPRING BOOT BACKEND ENVIRONMENT TEMPLATE
# ==========================================

# Server Port
PORT=8081

# Frontend URL (For CORS and email verification links)
FRONTEND_URL=http://localhost:5173

# Demo Users Seeding (true | false)
APP_INIT_DEMO_USERS=false

# MongoDB Database Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/car_rental?retryWrites=true&w=majority
MONGODB_DATABASE=car_rental

# JWT Secret (256-bit / 32+ characters)
JWT_SECRET=your_secure_256_bit_jwt_secret_key_here_min_32_characters_long

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Services
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your_16_char_app_password
MAIL_FROM=no-reply@yourdomain.com

# Brevo (Sendinblue) HTTP API (Optional alternative to SMTP)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@yourdomain.com
BREVO_SENDER_NAME=DriveShare Car Rental

# Resend HTTP API (Optional alternative to SMTP)
RESEND_API_KEY=
RESEND_FROM=DriveShare <onboarding@resend.dev>

# UPI Payment Receiver
PAYMENT_UPI_ID=yourbusiness@upi
PAYMENT_UPI_NAME=DriveShare Car Rental
